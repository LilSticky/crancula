{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["api/**/*.ts", "app/**/*.ts", "vitest.node.config.ts"]
}
