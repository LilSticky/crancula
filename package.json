{
  "name": "crancula",
  "version": "0.2.0",
  "description": "Composer and converter for punched tape music scores",
  "homepage": "",
  "author": {
    "name": "Lil Sticky"
  },
  "keywords": [],
  "main": "app/main.mjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron --no && electron-builder install-app-deps",
    "ng": "ng",
    "start": "npm-run-all -p electron:serve ng:serve",
    "ng:serve": "ng serve -c dev -o",
    "build": "npm run electron:bundle && ng build --base-href ./index.html",
    "web:dev": "npm run build",
    "web:prod": "npm run build -- -c production",
    "electron": "electron",
    "electron:bundle": "tsc -p tsconfig.serve.json && node scripts/bundle-electron.mjs",
    "electron:serve": "wait-on tcp:4200 && npm run electron:bundle && electron . --serve",
    "electron:local": "npm run web:dev && electron .",
    "electron:build": "npm run web:prod && electron-builder build --publish=never",
    "test": "npm run test:node && ng test --watch=false",
    "test:node": "tsc -p tsconfig.node.json && vitest run -c vitest.node.config.ts",
    "test:node:watch": "vitest -c vitest.node.config.ts",
    "test:watch": "ng test",
    "e2e": "npm run web:prod && playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "lint": "ng lint",
    "i18n:check": "node scripts/check-i18n.mjs",
    "ux:screens": "npm run web:prod && playwright test -c e2e/ux/playwright.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@breezystack/lamejs": "1.2.7",
    "@ngrx/signals": "22.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "angular-eslint": "22.6.0",
    "conventional-changelog": "8.1.3",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-debug": "5.0.0",
    "electron-reloader": "2.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.3.15",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jsdom": "30.1.3",
    "npm-run-all": "4.1.5",
    "playwright": "1.64.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "browserslist": [
    "chrome 140"
  ]
}
