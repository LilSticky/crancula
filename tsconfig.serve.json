{
  "compilerOptions": {
    "noEmit": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "esModuleInterop": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "files": [
    "app/main.ts",
    "app/preload.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
